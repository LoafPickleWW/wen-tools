        },
        {
          "name": "totalItems",
          "type": "uint64"
        },
        {
          "name": "sold",
          "type": "uint64"
        }
      ],
      "desc": ""
    },
    {
      "name": "Purchase",
      "args": [
        {
          "name": "saleId",
          "type": "uint64"
        },
        {
          "name": "app",
          "type": "uint64"
        },
        {
          "name": "asset",
          "type": "uint64"
        },
        {
          "name": "buyer",
          "type": "address"
        },
        {
          "name": "price",
          "type": "uint64"
        }
      ],
      "desc": ""
    },
    {
      "name": "MetadataUpdated",
      "args": [
        {
          "name": "saleId",
          "type": "uint64"
        }
      ],
      "desc": ""
    },
    {
      "name": "SaleDeleted",
      "args": [
        {
