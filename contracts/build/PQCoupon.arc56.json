        "create": [],
        "call": [
          "NoOp"
        ]
      }
    },
    {
      "name": "claim",
      "desc": "Pay out all coupons to the beneficiary, delete the printer box and refund its MBR.\nIf the beneficiary has opted out since registering, the coupons are forfeited\n(they stay with the app) so the deposit can never be locked. Returns coupons paid.\nThe caller covers the two inner transaction fees.",
      "args": [],
      "returns": {
        "type": "uint64"
      },
      "actions": {
        "create": [],
        "call": [
          "NoOp"
        ]
      }
    },
    {
      "name": "pending",
      "desc": "Read-only: coupons owed to a printer that has not claimed yet.",
      "readonly": true,
      "args": [
        {
          "name": "printer",
          "type": "address"
        }
      ],
      "returns": {
