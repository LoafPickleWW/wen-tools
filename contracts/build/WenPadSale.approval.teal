	frame_dig 3 // amount: uint64
	bytec 4 //  "p"
	frame_dig 5 // i: uint64
	intc 4 // 32
	+
	intc 2 // 8
	box_extract
	btoi
	mulw
	intc 0 // 0
	intc 10 // 10000
	divmodw
	pop
	pop
	swap
	!

	// wideRatio failed
