	frame_bury 4 // allocated: uint64

*for_2_continue:
	// contracts\WenPadSale.algo.ts:630
	// i = i + PAYOUT_STORED_BYTES
	frame_dig 5 // i: uint64
	intc 5 // 48
	+
	frame_bury 5 // i: uint64
	b *for_2

*for_2_end:
	// contracts\WenPadSale.algo.ts:634
	// retained = 0
