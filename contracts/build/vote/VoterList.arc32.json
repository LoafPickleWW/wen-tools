                    }
                ],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Add voters. `pay` covers the new boxes' MBR. Any surplus is returned."
            },
            {
                "name": "close",
                "args": [],
                "readonly": false,
                "returns": {
                    "type": "void"
                },
                "desc": "Called by the factory's closeVoterList once the list is empty. Remaining ALGO goes to the owner."
