	// contracts\WenPadSale.algo.ts:940
	// preMbr = this.app.address.minBalance
	global CurrentApplicationAddress
	acct_params_get AcctMinBalance
	pop
	frame_bury 3 // preMbr: uint64

	// contracts\WenPadSale.algo.ts:942
	// sendMethodCall<typeof WenPadSale.prototype.deleteApplication>({
	//       applicationID: app,
	//       onCompletion: OnCompletion.DeleteApplication,
	//       fee: 0,
	//     })
	itxn_begin
	intc 4 //  appl
	itxn_field TypeEnum
	pushbytes 0x2487c32c // method "deleteApplication()void"
	itxn_field ApplicationArgs

	// contracts\WenPadSale.algo.ts:943
